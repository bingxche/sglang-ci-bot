flowchart TB
    classDef purpose fill:#ffffff,stroke:#ffffff,color:#111
    classDef trigger fill:#e8eefc,stroke:#5b7bd5,color:#1b2a4a
    classDef workflow fill:#f4f4f4,stroke:#888,color:#222
    classDef agent fill:#fff4e0,stroke:#d99a2b,color:#3d2a00
    classDef code fill:#eaf6ea,stroke:#4c9a4c,color:#173d17
    classDef output fill:#f3e8fb,stroke:#9a5bc4,color:#341a47

    subgraph L1[" "]
        direction LR
        P1["<b>① CI monitor</b><br/>explain every AMD<br/>CI failure, daily"]:::purpose ~~~ A1(["hourly timer<br/>(runner-1)"]):::trigger --> A2["ci-monitor.yml"]:::workflow --> A3{{"agents: per job →<br/>per workflow →<br/>daily summary"}}:::agent --> A4[("daily issue<br/>in this repo")]:::output --> A5["finalize: code checks<br/>+ 3 verifier agents"]:::code --> A6[("sglang: suspect-PR<br/>comments, trackers")]:::output
    end

    subgraph L2[" "]
        direction LR
        P2["<b>② @amd-bot review</b><br/>review a sglang PR"]:::purpose ~~~ B1(["@amd-bot review"]):::trigger --> B2["watcher →<br/>pr-review.yml"]:::workflow --> B3{{"4 reviewer agents"}}:::agent --> B4["code checks<br/>+ 3 verifier agents"]:::code --> B5[("review on<br/>the sglang PR")]:::output
    end

    subgraph L3[" "]
        direction LR
        P3["<b>③ @amd-bot ci-status</b><br/>did this PR break CI?"]:::purpose ~~~ C1(["@amd-bot ci-status"]):::trigger --> C2["watcher →<br/>ci-status-check.yml"]:::workflow --> C3["evidence pack<br/>(code)"]:::code --> C4{{"attribution agent"}}:::agent --> C5["verdicts checked<br/>against evidence"]:::code --> C6[("comment on<br/>the sglang PR")]:::output
    end

    subgraph L4[" "]
        direction LR
        P4["<b>④ On-demand</b><br/>explain one CI run<br/>you paste in"]:::purpose ~~~ D1(["Actions tab:<br/>run or job URL"]):::trigger --> D2["analyze-ci.yml"]:::workflow --> D3{{"agents: each job,<br/>cross-job"}}:::agent --> D4[("Analyze issue<br/>in this repo")]:::output
    end

    subgraph L5[" "]
        direction LR
        P5["<b>⑤ Notion staging</b><br/>propose entries for<br/>the known-errors table"]:::purpose ~~~ E1(["every day"]):::trigger --> E2["notion-staging.yml"]:::workflow --> E3{{"candidates agent<br/>(reads daily issues)"}}:::agent --> E4["stability gate<br/>+ dedup (code)"]:::code --> E5[("Notion<br/>staging table")]:::output
    end

    subgraph L6[" "]
        direction LR
        P6["<b>⑥ Coverage audit</b><br/>find NVIDIA-only tests<br/>that can never run on AMD"]:::purpose ~~~ F1(["every Monday"]):::trigger --> F2["coverage-audit.yml"]:::workflow --> F3{{"agents: can this test<br/>ever run on ROCm?"}}:::agent --> F4["update exclusion list,<br/>run tests (code)"]:::code --> F5[("PR merged into<br/>ROCm/sglang-ci")]:::output
    end

